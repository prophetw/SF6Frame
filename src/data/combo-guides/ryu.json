    },
    {
      "difficulty": "中等",
      "when": "跳重拳打中地面上的对手，落地接后重拳，再用重升龙取伤害。",
      "input": "j.HP → 4HP → 623HP"
    }
  ],
  "punish": [
    {
      "difficulty": "入门",
      "when": "近身防住 -6F 或更大破绽时，用站中拳确反。看到确反提示就接站重拳，用重升龙收尾。",
      "input": "5MP → 5HP → 623HP"
    },
    {
      "difficulty": "中等",
      "when": "对手贴身出招被挡后只有 -4F 时，用站轻拳抢这 4 帧。确反命中就接蹲中脚和中足刀。",
      "input": "5LP → 2MK → 236MK"
    },
    {
      "difficulty": "中等",
      "when": "防住 -5F 或更大破绽，却被推到站轻拳够不到的位置时，只要站轻脚还踢得到，就用它确反接中龙卷搬运。",
      "input": "5LK → 214MK"
    },
    {
      "difficulty": "中等",
      "when": "防住升龙等对手落地，或后退骗对手投空时，用站重脚打出崩地。普通前冲追上，再用蹲重拳接重升龙。",
      "input": "5HK → 前冲 → 2HP → 623HP"
    },
    {
      "difficulty": "高级",
      "when": "站重拳打到对方收招时，可以接平常接不上的重波掌击，再用中龙卷搬运。",
      "input": "5HP → 214HP → 214MK"
    }
  ],
  "rush": [
    {
      "difficulty": "中等",
      "when": "蹲中脚抓到对方走动时，取消绿冲贴近，用站重拳接后重拳把牵制转成击倒。",
      "input": "2MK → DRC → 5HP → 4HP → 623HP"
    },
    {
      "difficulty": "入门",
      "when": "对手站着后退时，裸绿冲用蹲中脚抓下段。打中就接站轻脚和轻足刀，被挡住就准备防守。",
      "input": "裸 DR → 2MK → 5LK → 236LK"
    },
    {
      "difficulty": "中等",
      "when": "对手习惯蹲防时，裸绿冲用前中拳打中段。打中接站中拳和重升龙，被挡住也能继续近身施压。",
      "input": "裸 DR → 6MP → 5MP → 623HP"
    }
  ]
