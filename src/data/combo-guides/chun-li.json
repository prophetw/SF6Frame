      "input": "5LP → 2HK"
    },
    {
      "difficulty": "入门",
      "when": "看见对方出招收不回去、蹲中脚够得到时，确反可直接接重百裂脚。",
      "input": "2MK → 236HK"
    },
    {
      "difficulty": "中等",
      "when": "防住无敌技的大破绽时，站重拳进架构，架构中脚之后直接出重回旋鹤脚。",
      "input": "5HP → 214P~MK → 28HK"
    }
  ],
  "rush": [
    {
      "difficulty": "中等",
      "when": "蹲中脚在地面战摸中后，用取消绿冲靠近，后重拳进架构再用中回旋鹤脚击倒。",
      "input": "2MK → DRC → 5MP → 4HP → 214P~LK → 28MK"
    },
    {
      "difficulty": "中等",
      "when": "对手一直蹲防时，裸绿冲用水莲拳打中段，命中就蹲中拳接蓄力腿。",
      "input": "裸 DR → 3HP → 2MP → [2]8MK"
    },
    {
      "difficulty": "高级",
      "when": "蹲中脚绿冲打中，想练空中收尾时，用架构重脚挑空，再接踩踏和空中双重拳。",
      "input": "2MK → DRC → 4HP → 214P~HK → j.2MK → j.HP~HP"
    }
  ],
