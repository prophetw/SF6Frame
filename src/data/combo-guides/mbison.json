    },
    {
      "difficulty": "中等",
      "when": "对手身上已经有雷时，近身按站中拳后立刻蓄后。蹲中拳打中就花两格斗气用 OD 碾压引爆，接重背拳再挂一颗雷。",
      "input": "5MP → 2MP → [4]6PP → 214HP"
    }
