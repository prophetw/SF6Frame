      "input": "5LK → DRC → 5MK → 236HK → j.214LP"
    },
    {
      "difficulty": "中等",
      "when": "站重脚踢到对方收招时，确反足够接站中拳，再用熟悉的中脚派生击倒。",
      "input": "5HK → 5MP~MK → 236MK"
    }
  ],
  "rush": [
    {
      "difficulty": "中等",
      "when": "蹲中脚截住后退时取消绿冲，先用站重脚打中，再转熟悉的中拳目标连段。",
      "input": "2MK → DRC → 5HK → 5MP~MK → 236MK"
    },
    {
      "difficulty": "中等",
      "when": "对手习惯蹲防时，先用一格斗气裸绿冲打前中拳中段。命中后接中拳派生，再花三格取消绿冲追击。",
      "input": "裸 DR → 6MP → 5MP~MK → DRC → 2HP → 236HK → j.214MP"
    },
    {
      "difficulty": "中等",
      "when": "蹲中拳命中时取消绿冲，接蹲重拳和重日升踢，空中轻日焰收尾后便于前冲继续压。",
      "input": "2MP → DRC → 2HP → 236HK → j.214LP"
    },
    {
      "difficulty": "高级",
      "when": "站轻脚差返打出确反、有斗气时，取消绿冲接站中脚，再追空中中日焰取伤害。",
      "input": "5LK → DRC → 5MK → 236HK → j.214MP"
    }
